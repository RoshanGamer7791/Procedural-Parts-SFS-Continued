--- !u!114 &8259951151568352854
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1137496768567648}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 08d5f04d6ea54b1489357be5022f4158, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  numericCalculators:
  - input:
      variables: {fileID: 4991792360319987076}
      input: x_position_target + x_position_smooth_target
    output:
      variableName: x_position_variable
      referenceToVariables: {fileID: 4991792360319987076}
      localValue: 0
  - input:
      variables: {fileID: 4991792360319987076}
      input: y_position_target + y_position_smooth_target
    output:
      variableName: y_position_variable
      referenceToVariables: {fileID: 4991792360319987076}
      localValue: 0
  - input:
      variables: {fileID: 4991792360319987076}
      input: x_size_time  * x_size_soomth_time
    output:
      variableName: x_size_variable
      referenceToVariables: {fileID: 4991792360319987076}
      localValue: 1
  - input:
      variables: {fileID: 4991792360319987076}
      input: y_size_time  * y_size_soomth_time
    output:
      variableName: y_size_variable
      referenceToVariables: {fileID: 4991792360319987076}
      localValue: 0
  - input:
      variables: {fileID: 4991792360319987076}
      input: (0.25 * x_size_variable)
    output:
      variableName: center_of_mass_x
      referenceToVariables: {fileID: 4991792360319987076}
      localValue: 0
  - input:
      variables: {fileID: 4991792360319987076}
      input: (0.25 * y_size_variable)
    output:
      variableName: center_of_mass_y
      referenceToVariables: {fileID: 4991792360319987076}
      localValue: 0
  - input:
      variables: {fileID: 4991792360319987076}
      input: center_of_mass_x * cos_target - center_of_mass_y * sin_target
    output:
      variableName: angle_output_x
      referenceToVariables: {fileID: 4991792360319987076}
      localValue: 0
  - input:
      variables: {fileID: 4991792360319987076}
      input: center_of_mass_x * sin_target + center_of_mass_y * cos_target
    output:
      variableName: angle_output_y
      referenceToVariables: {fileID: 4991792360319987076}
      localValue: 0
  - input:
      variables: {fileID: 4991792360319987076}
      input: x_position_variable + angle_output_x
    output:
      variableName: x_position_variable_output
      referenceToVariables: {fileID: 4991792360319987076}
      localValue: 0.25
  - input:
      variables: {fileID: 4991792360319987076}
      input: y_position_variable + angle_output_y
    output:
      variableName: y_position_variable_output
      referenceToVariables: {fileID: 4991792360319987076}
      localValue: 0.25
  booleanComparisonCalculators: []
  booleanOperatorCalculators: []
